## Root environment template
# Use a Neon connection string for production, or a local Postgres URL for development
#DATABASE_URL=postgres://postgres:postgres@postgres:5432/attendance

# Neon production placeholders (do NOT commit real credentials)
# Example values should be set in the runtime environment or CI secrets
# DATABASE_URL: use the Neon pooler URL
# DIRECT_URL: use the Neon direct (admin) URL for operations that require a direct connection
DATABASE_URL=
DIRECT_URL=
# Optional override for services (local dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=attendance

DATABASE_URL=postgresql://neondb_owner:...
JWT_SECRET=smart-attendance-local-secret-key
ACCESS_EXPIRES=15m
