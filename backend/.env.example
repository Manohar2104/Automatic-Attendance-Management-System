# Backend environment template
# Set runtime connection strings via environment variables or CI secrets
# For Neon production use the pooler URL in `DATABASE_URL` and the direct admin URL in `DIRECT_URL`.
# Do NOT hardcode credentials in this file or commit secrets to source control.

# Example local development URL (Docker Postgres)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/attendance

# Neon production placeholders (replace in runtime environment)
DATABASE_URL=<neon_pooler_url>
DIRECT_URL=<neon_direct_url>

# Server port
PORT=3000
